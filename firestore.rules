rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVsmartAdmin() {
      return isEmailVerified() && request.auth.token.email == 'designanddevelopment02@gmail.com';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && (getUserData().get('role', 'user') == role || isVsmartAdmin());
    }
    
    function isAdmin() {
      return hasRole('admin') || isVsmartAdmin();
    }
    
    function isStaff() {
      return hasRole('admin') || hasRole('staff') || isVsmartAdmin();
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && 
        incoming().role == 'user';
      allow update: if isVsmartAdmin() || (isSignedIn() && request.auth.uid == userId && 
        incoming().role == resource.data.role);
    }

    // --- Knowledge Base ---
    match /knowledge_base/{articleId} {
      allow read: if isSignedIn();
      allow write: if isStaff() && isEmailVerified();
    }

    // --- Historical Queries ---
    match /queries/{queryId} {
      allow read: if isSignedIn();
      allow write: if isStaff() && isEmailVerified();
    }

    // --- Chats ---
    match /chats/{chatId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid || isStaff());
        allow create: if isSignedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid || isStaff());
      }
    }
  }
}
